# Credenziali Grafana
GRAFANA_ADMIN_PASSWORD=change_me

# API Strava
STRAVA_TOKEN=your_strava_access_token_here

# Per Gmail usa un'app password, non la normale password dell'account.
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=your_gmail_address_here
GF_SMTP_PASSWORD=your_gmail_app_password_here
GF_SMTP_FROM_ADDRESS=your_gmail_address_here
GF_SMTP_FROM_NAME=StravaEngine
GF_ALERT_EMAIL_TO=alert_recipient_email_here
